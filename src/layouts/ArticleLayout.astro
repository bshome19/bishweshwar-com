---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  readingTime?: string;
  canonicalUrl?: string;
  externalUrl?: string;
  section?: 'Blog' | 'Labs' | 'Projects';
  sectionHref?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags = [],
  readingTime,
  canonicalUrl,
  externalUrl,
  section = 'Blog',
  sectionHref = '/blog',
} = Astro.props;

const formattedDate = pubDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(pubDate)
  : null;

const currentUrl = canonicalUrl || new URL(Astro.url.pathname, SITE.url).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': section === 'Blog' ? 'BlogPosting' : 'TechArticle',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
  },
  datePublished: pubDate ? pubDate.toISOString() : undefined,
  dateModified: updatedDate ? updatedDate.toISOString() : pubDate ? pubDate.toISOString() : undefined,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl,
  },
  keywords: tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: section,
      item: new URL(sectionHref, SITE.url).href,
    },
    ...(category
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: category.toUpperCase(),
            item: new URL(`${sectionHref}/${category.toLowerCase()}`, SITE.url).href,
          },
          {
            '@type': 'ListItem',
            position: 4,
            name: title,
            item: currentUrl,
          },
        ]
      : [
          {
            '@type': 'ListItem',
            position: 3,
            name: title,
            item: currentUrl,
          },
        ]),
  ],
};
---

<BaseLayout title={`${title} — Bishweshwar Shome`} description={description} canonical={canonicalUrl} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <article class="article-page">
    <div class="container-article">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href={sectionHref}>{section}</a>
        {
          category && (
            <>
              <span class="breadcrumb-sep">/</span>
              <span class="breadcrumb-category">{category}</span>
            </>
          )
        }
      </nav>

      <!-- Article Header -->
      <header class="article-header">
        {category && <span class="badge badge-cyan">{category.toUpperCase()}</span>}
        <h1 class="article-title">{title}</h1>
        <p class="article-description">{description}</p>

        <div class="article-meta">
          {formattedDate && (
            <time datetime={pubDate?.toISOString()} class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>{formattedDate}</span>
            </time>
          )}

          {readingTime && (
            <span class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>{readingTime}</span>
            </span>
          )}

          <span class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>Bishweshwar Shome</span>
          </span>
        </div>

        {externalUrl && (
          <div class="canonical-notice">
            <span>Published originally in <strong>Dev Genius on Medium</strong>.</span>
            <a href={externalUrl} target="_blank" rel="noopener noreferrer">
              View original publication on Medium ↗
            </a>
          </div>
        )}
      </header>

      <!-- Article Body -->
      <div class="prose article-body">
        <slot />
      </div>

      <!-- Article Footer / Tags -->
      {tags.length > 0 && (
        <footer class="article-footer">
          <h2 class="tags-heading">Tags</h2>
          <div class="tags-list">
            {tags.map((tag) => (
              <span class="badge">#{tag}</span>
            ))}
          </div>

          <div class="back-link-wrapper">
            <a href={sectionHref} class="btn btn-secondary btn-sm">
              &larr; Back to {section}
            </a>
          </div>
        </footer>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding: 3rem 0 5rem;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent-primary);
  }

  .breadcrumb-sep {
    color: var(--border-default);
  }

  .breadcrumb-category {
    color: var(--accent-cyan);
    text-transform: capitalize;
  }

  .article-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .article-title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    margin: 1rem 0 0.75rem;
    line-height: 1.25;
  }

  .article-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .canonical-notice {
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .canonical-notice a {
    color: var(--accent-primary);
    font-weight: 500;
  }

  .article-body {
    margin-bottom: 4rem;
  }

  .article-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: 2rem;
  }

  .tags-heading {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .back-link-wrapper {
    display: flex;
  }
</style>
