---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../data/site';
import { getTrackById } from '../data/learnCurriculum';

interface Props {
  title: string;
  description?: string;
  trackId?: string;
  level?: 'beginner' | 'intermediate' | 'advanced' | 'expert' | 'all';
  duration?: number;
  prerequisites?: string[];
  concepts?: string[];
  tags?: string[];
  prevLesson?: { title: string; href: string };
  nextLesson?: { title: string; href: string };
  lessonId?: string;
}

const {
  title,
  description = 'Master System Design, Distributed Systems, High-Level Design, Low-Level Design, and AI Architecture from first principles.',
  trackId,
  level = 'beginner',
  duration,
  prerequisites = [],
  concepts = [],
  tags = [],
  prevLesson,
  nextLesson,
  lessonId,
} = Astro.props;

const track = trackId ? getTrackById(trackId) : undefined;
const currentUrl = new URL(Astro.url.pathname, SITE.url).href;

const levelColors: Record<string, string> = {
  beginner: 'badge-emerald',
  intermediate: 'badge-cyan',
  advanced: 'badge-amber',
  expert: 'badge-purple',
  all: 'badge-cyan',
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Learn', href: '/learn' },
  ...(track ? [{ name: track.title, href: `/learn/${track.id}` }] : []),
  ...(trackId && title !== track?.title ? [{ name: title, href: Astro.url.pathname }] : []),
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.name,
    item: new URL(crumb.href, SITE.url).href,
  })),
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl,
  },
  keywords: [...concepts, ...tags, track?.title || 'System Design'].join(', '),
};
---

<BaseLayout title={`${title} — System Design Learn | ${SITE.name}`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="learn-page">
    <div class="container-article">
      <!-- Breadcrumbs -->
      <nav class="learn-breadcrumbs" aria-label="Breadcrumbs">
        {
          breadcrumbs.map((crumb, idx) => (
            <>
              {idx > 0 && <span class="breadcrumb-sep" aria-hidden="true">/</span>}
              {idx === breadcrumbs.length - 1 ? (
                <span class="breadcrumb-current" aria-current="page">{crumb.name}</span>
              ) : (
                <a href={crumb.href} class="breadcrumb-link">{crumb.name}</a>
              )}
            </>
          ))
        }
      </nav>

      <!-- Lesson Header -->
      <header class="learn-header">
        <div class="learn-meta-pills">
          {track && (
            <a href={`/learn/${track.id}`} class="badge badge-track">
              <span>{track.icon}</span> {track.title}
            </a>
          )}
          <span class:list={['badge', levelColors[level] || 'badge-cyan']}>
            {level.toUpperCase()}
          </span>
          {duration && (
            <span class="badge badge-duration">
              ⏱️ {duration} min study
            </span>
          )}
        </div>

        <h1 class="learn-title">{title}</h1>

        {description && <p class="learn-lead">{description}</p>}

        {concepts.length > 0 && (
          <div class="learn-concepts">
            <span class="concepts-label">Concepts:</span>
            {concepts.map((concept) => (
              <span class="concept-tag">#{concept}</span>
            ))}
          </div>
        )}

        <!-- Interactive Progress State -->
        {lessonId && (
          <div class="lesson-progress-bar" data-lesson-id={lessonId}>
            <label class="progress-checkbox-label">
              <input type="checkbox" id="lesson-complete-toggle" class="progress-checkbox" />
              <span class="progress-text">Mark lesson completed</span>
            </label>
            <span id="lesson-status-badge" class="badge badge-subtle">Not Started</span>
          </div>
        )}
      </header>

      <!-- Prerequisites Box -->
      {prerequisites.length > 0 && (
        <aside class="prerequisites-callout" aria-label="Lesson Prerequisites">
          <div class="prerequisites-header">
            <span class="prereq-icon">⚠️</span>
            <strong>Prerequisites for this lesson:</strong>
          </div>
          <ul class="prerequisites-list">
            {prerequisites.map((prereq) => (
              <li>
                <span class="prereq-code"><code>{prereq}</code></span>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <!-- Main Lesson Content -->
      <article class="prose learn-prose">
        <slot />
      </article>

      <!-- Previous / Next Navigation -->
      {(prevLesson || nextLesson) && (
        <nav class="lesson-pagination" aria-label="Lesson navigation">
          {prevLesson ? (
            <a href={prevLesson.href} class="pagination-link prev">
              <span class="pagination-dir">&larr; Previous Lesson</span>
              <span class="pagination-title">{prevLesson.title}</span>
            </a>
          ) : (
            <div />
          )}

          {nextLesson && (
            <a href={nextLesson.href} class="pagination-link next">
              <span class="pagination-dir">Next Lesson &rarr;</span>
              <span class="pagination-title">{nextLesson.title}</span>
            </a>
          )}
        </nav>
      )}

      <!-- Footer Jump -->
      <footer class="learn-article-footer">
        {track && (
          <a href={`/learn/${track.id}`} class="btn btn-secondary btn-sm">
            &larr; Back to {track.title} Track
          </a>
        )}
        <a href="/learn" class="btn btn-secondary btn-sm">
          Browse All Tracks
        </a>
        <a href="/learn/playground" class="btn btn-primary btn-sm">
          Launch Playground 🔬
        </a>
      </footer>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const toggle = document.getElementById('lesson-complete-toggle');
    const badge = document.getElementById('lesson-status-badge');
    const container = document.querySelector('.lesson-progress-bar');
    if (!toggle || !container) return;

    const lessonId = container.getAttribute('data-lesson-id');
    if (!lessonId) return;

    const storageKey = 'learn.progress.completed';

    function getCompleted() {
      try {
        return JSON.parse(localStorage.getItem(storageKey) || '[]');
      } catch {
        return [];
      }
    }

    function setCompleted(list) {
      try {
        localStorage.setItem(storageKey, JSON.stringify(list));
      } catch {}
    }

    const completedList = getCompleted();
    const isDone = completedList.includes(lessonId);
    toggle.checked = isDone;
    updateBadge(isDone);

    toggle.addEventListener('change', (e) => {
      const checked = e.target.checked;
      let list = getCompleted();
      if (checked && !list.includes(lessonId)) {
        list.push(lessonId);
      } else if (!checked) {
        list = list.filter((id) => id !== lessonId);
      }
      setCompleted(list);
      updateBadge(checked);
    });

    function updateBadge(done) {
      if (!badge) return;
      if (done) {
        badge.textContent = 'Completed ✓';
        badge.className = 'badge badge-emerald';
      } else {
        badge.textContent = 'In Progress';
        badge.className = 'badge badge-subtle';
      }
    }
  })();
</script>

<style>
  .learn-page {
    padding: 3rem 0 5rem;
  }

  .learn-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: var(--accent-primary);
  }

  .breadcrumb-sep {
    color: var(--border-default);
  }

  .breadcrumb-current {
    color: var(--text-primary);
    font-weight: 500;
  }

  .learn-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .learn-meta-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .badge-track {
    text-decoration: none;
    color: var(--text-primary);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    transition: border-color var(--transition-fast);
  }

  .badge-track:hover {
    border-color: var(--accent-primary);
  }

  .badge-emerald {
    background: rgba(52, 211, 153, 0.12);
    color: var(--accent-emerald);
    border-color: rgba(52, 211, 153, 0.3);
  }

  .badge-duration {
    background: var(--bg-muted);
    color: var(--text-secondary);
  }

  .badge-subtle {
    background: var(--bg-surface);
    color: var(--text-muted);
    border-color: var(--border-subtle);
  }

  .learn-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .learn-lead {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .learn-concepts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .concepts-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .concept-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
    background: rgba(6, 182, 212, 0.08);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(6, 182, 212, 0.2);
  }

  .lesson-progress-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .progress-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .progress-checkbox {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent-emerald);
    cursor: pointer;
  }

  .prerequisites-callout {
    background: rgba(251, 191, 36, 0.06);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-left: 4px solid var(--accent-amber);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
  }

  .prerequisites-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--accent-amber);
    margin-bottom: 0.5rem;
  }

  .prerequisites-list {
    margin: 0;
    padding-left: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .prerequisites-list li {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .learn-prose {
    margin-bottom: 3.5rem;
  }

  .lesson-pagination {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .lesson-pagination {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none !important;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .pagination-link:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  .pagination-link.next {
    text-align: right;
  }

  .pagination-dir {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-bottom: 0.35rem;
  }

  .pagination-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .learn-article-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-subtle);
  }
</style>
