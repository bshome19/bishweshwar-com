---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, EXPERIENCES } from '../data/site';
---

<BaseLayout title={`Work Experience — ${SITE.name}`} description="Career history and technical accomplishments of Bishweshwar Shome across F5 Networks, IBM, HCL, and Prescience Insilico.">
  <div class="experience-page">
    <div class="container">
      <header class="page-header">
        <span class="badge badge-cyan">CAREER HISTORY</span>
        <h1 class="page-title">Professional Experience</h1>
        <p class="page-lead">
          Over 6 years of backend engineering across distributed cloud networks, AI-assisted development pipelines,
          and high-throughput microservices.
        </p>
      </header>

      <div class="timeline">
        {
          EXPERIENCES.map((exp, idx) => (
            <div class="timeline-item">
              <!-- Timeline Marker -->
              <div class="timeline-marker">
                <div class="marker-dot"></div>
                {idx !== EXPERIENCES.length - 1 && <div class="marker-line"></div>}
              </div>

              <!-- Content Card -->
              <div class="timeline-content card">
                <div class="exp-header-row">
                  <div>
                    <div class="role-badge-row">
                      <h2 class="exp-title">{exp.role}</h2>
                      {idx === 0 && <span class="badge badge-active"><span class="status-dot"></span> Most Recent</span>}
                    </div>
                    <div class="exp-company-info">
                      <span class="company-name">{exp.company}</span>
                      {exp.subcontract && <span class="subcontract-name">({exp.subcontract})</span>}
                    </div>
                  </div>

                  <div class="exp-timing">
                    <span class="badge badge-timing">{exp.period}</span>
                    <span class="exp-location">{exp.location}</span>
                  </div>
                </div>

                <div class="exp-body">
                  <h3 class="section-subheading">Key Technical Accomplishments:</h3>
                  <ul class="accomplishments-list">
                    {exp.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>

                <div class="exp-tech-footer">
                  <span class="tech-label">Technologies &amp; Competencies:</span>
                  <div class="tech-tags">
                    {exp.skills.map((s) => (
                      <span class="badge">{s}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .experience-page {
    padding: 3.5rem 0 5rem;
  }

  .page-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 2rem;
    margin-bottom: 3.5rem;
  }

  .page-title {
    margin: 0.75rem 0 0.5rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 780px;
    line-height: 1.6;
    margin: 0;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .timeline-item {
      grid-template-columns: 32px 1fr;
      gap: 2rem;
    }
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding-top: 1.5rem;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-base);
    border: 3px solid var(--accent-primary);
    z-index: 2;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
  }

  .marker-line {
    width: 2px;
    background: var(--border-default);
    flex: 1;
    margin-top: 0.5rem;
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .exp-header-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .role-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .exp-title {
    font-size: 1.35rem;
    margin: 0;
  }

  .exp-company-info {
    margin-top: 0.25rem;
    font-size: 1rem;
  }

  .company-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .subcontract-name {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-left: 0.35rem;
  }

  .exp-timing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .badge-timing {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .exp-location {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .section-subheading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .accomplishments-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .accomplishments-list li {
    position: relative;
    padding-left: 1.35rem;
  }

  .accomplishments-list li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-primary);
    font-size: 0.9rem;
  }

  .exp-tech-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tech-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
</style>
