---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title={`404: Page Not Found — ${SITE.name}`} description="The requested page could not be located on bishweshwar.com.">
  <div class="not-found-page">
    <div class="container">
      <div class="card not-found-card">
        <span class="badge badge-rose">HTTP 404 NOT FOUND</span>
        <h1 class="error-code">404</h1>
        <h2 class="error-title">Route Not Found in Address Space</h2>
        <p class="error-desc">
          The requested endpoint does not exist or has been relocated during service re-architecture.
        </p>

        <div class="suggested-routes">
          <span class="routes-label">Available entry points:</span>
          <div class="routes-links">
            <a href="/" class="btn btn-primary btn-sm">Return Home</a>
            <a href="/projects" class="btn btn-secondary btn-sm">Projects</a>
            <a href="/labs" class="btn btn-secondary btn-sm">Labs</a>
            <a href="/blog" class="btn btn-secondary btn-sm">Blog</a>
            <a href="/contact" class="btn btn-secondary btn-sm">Contact</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    padding: 6rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
  }

  .not-found-card {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    padding: 3.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .badge-rose {
    background: rgba(251, 113, 133, 0.12);
    color: var(--accent-rose);
    border-color: rgba(251, 113, 133, 0.25);
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 10vw, 6rem);
    font-weight: 800;
    line-height: 1;
    color: var(--accent-primary);
    margin: 0;
    letter-spacing: -0.05em;
  }

  .error-title {
    font-size: 1.5rem;
    margin: 0;
  }

  .error-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 440px;
    line-height: 1.6;
  }

  .suggested-routes {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .routes-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .routes-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
</style>
