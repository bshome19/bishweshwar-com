---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../data/site';
import { LEARN_TRACKS, LEARNING_PATHS, getTrackById } from '../../../data/learnCurriculum';
import LessonCard from '../../../components/learn/LessonCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allLessons = await getCollection('learn', ({ data }) => !data.draft);

  return LEARN_TRACKS.map((track) => {
    const trackLessons = allLessons
      .filter((l) => l.data.track === track.id)
      .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

    return {
      params: { track: track.id },
      props: {
        track,
        lessons: trackLessons,
      },
    };
  });
}

const { track, lessons = [] } = Astro.props;

// Related learning paths
const relatedPaths = LEARNING_PATHS.filter((p) => p.trackIds.includes(track.id));

// Find next track
const curIdx = LEARN_TRACKS.findIndex((t) => t.id === track.id);
const nextTrack = curIdx >= 0 && curIdx < LEARN_TRACKS.length - 1 ? LEARN_TRACKS[curIdx + 1] : undefined;
---

<BaseLayout
  title={`${track.title} Track — System Design Learn | ${SITE.name}`}
  description={track.description}
>
  <div class="track-syllabus-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="learn-breadcrumbs" aria-label="Breadcrumbs">
        <a href="/" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/learn" class="breadcrumb-link">Learn</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{track.title}</span>
      </nav>

      <!-- Track Header -->
      <header class="track-header">
        <div class="track-meta-pills">
          <span class="badge badge-purple">{track.level.toUpperCase()}</span>
          <span class="badge badge-subtle">{track.badge}</span>
          <span class="badge badge-subtle">{lessons.length} {lessons.length === 1 ? 'Lesson' : 'Lessons'}</span>
        </div>

        <div class="track-title-row">
          <span class="track-icon-lg">{track.icon}</span>
          <h1 class="track-main-title">{track.title}</h1>
        </div>

        <p class="track-main-desc">{track.description}</p>
      </header>

      <!-- Lessons Syllabus List -->
      <section class="syllabus-section">
        <h2 class="section-label">Track Syllabus &amp; Deep Dives</h2>

        {lessons.length === 0 ? (
          <div class="card empty-syllabus-card">
            <p>Lessons for this track are currently being expanded. Check out the <a href="/learn/playground">Interactive Playground</a> or explore other tracks below!</p>
          </div>
        ) : (
          <div class="syllabus-grid">
            {lessons.map((lesson) => {
              const cleanSlug = lesson.slug.split('/').pop()?.replace(/^\d+-/, '') || lesson.slug;
              return (
                <LessonCard
                  title={lesson.data.title}
                  href={`/learn/${track.id}/${cleanSlug}`}
                  level={lesson.data.level}
                  duration={lesson.data.duration}
                  concepts={lesson.data.concepts}
                  interactive={lesson.data.interactive?.enabled}
                  order={lesson.data.order}
                  description={lesson.data.description}
                  lessonId={lesson.data.id || cleanSlug}
                />
              );
            })}
          </div>
        )}
      </section>

      <!-- Related Learning Paths -->
      {relatedPaths.length > 0 && (
        <section class="related-paths-section">
          <h3 class="sub-section-label">Recommended Guided Learning Paths</h3>
          <div class="paths-sub-grid">
            {relatedPaths.map((p) => (
              <div class="card path-mini-card">
                <span class="badge badge-purple">{p.badge}</span>
                <h4 class="path-mini-title">{p.title}</h4>
                <p class="path-mini-desc">{p.description}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Track Navigation Footer -->
      <footer class="track-nav-footer">
        <a href="/learn" class="btn btn-secondary btn-sm">
          &larr; Back to All 19 Tracks
        </a>

        {nextTrack && (
          <a href={`/learn/${nextTrack.id}`} class="btn btn-primary btn-sm">
            Next Track: {nextTrack.title} &rarr;
          </a>
        )}
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  .track-syllabus-page {
    padding: 3rem 0 5rem;
  }

  .learn-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--accent-primary);
  }

  .breadcrumb-sep {
    color: var(--border-default);
  }

  .breadcrumb-current {
    color: var(--text-primary);
    font-weight: 500;
  }

  .track-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
  }

  .track-meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .track-title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .track-icon-lg {
    font-size: 2.25rem;
  }

  .track-main-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .track-main-desc {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 820px;
    line-height: 1.65;
    margin: 0;
  }

  .syllabus-section {
    margin-bottom: 3.5rem;
  }

  .section-label {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .syllabus-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .empty-syllabus-card {
    padding: 2rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .related-paths-section {
    margin-bottom: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .sub-section-label {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .paths-sub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .paths-sub-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .path-mini-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .path-mini-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .path-mini-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .track-nav-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }
</style>
