---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { LEARN_TRACKS, LEARNING_PATHS } from '../../data/learnCurriculum';
import TrackCard from '../../components/learn/TrackCard.astro';
import LearningPathCard from '../../components/learn/LearningPathCard.astro';
import LearnSearch from '../../components/learn/LearnSearch.astro';
import { getCollection } from 'astro:content';

const allLessons = await getCollection('learn', ({ data }) => !data.draft);
allLessons.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Count lessons per track
const lessonCountByTrack: Record<string, number> = {};
allLessons.forEach((l) => {
  lessonCountByTrack[l.data.track] = (lessonCountByTrack[l.data.track] || 0) + 1;
});

// Prepare search items
const searchItems = allLessons.map((l) => {
  const cleanSlug = l.slug.split('/').pop()?.replace(/^\d+-/, '') || l.slug;
  return {
    title: l.data.title,
    href: `/learn/${l.data.track}/${cleanSlug}`,
    track: l.data.track,
    level: l.data.level,
    concepts: l.data.concepts || [],
    description: l.data.description,
  };
});

const featuredLessons = allLessons.slice(0, 6);
---

<BaseLayout
  title={`System Design & Architecture Learning Platform — ${SITE.name}`}
  description="Comprehensive, interactive System Design and Software Architecture platform. Master HLD, LLD, distributed systems, machine coding, and AI architecture from first principles."
>
  <div class="learn-hub-page">
    <!-- Hero Section -->
    <section class="learn-hero">
      <div class="container">
        <div class="hero-badge-row">
          <span class="badge badge-cyan">SYSTEM DESIGN HUB</span>
          <span class="badge badge-purple">19 Tracks</span>
          <span class="badge badge-amber">8 Interactive Simulators</span>
        </div>

        <h1 class="learn-hero-title">
          Master System Design &amp; Software Architecture
        </h1>

        <p class="learn-hero-subtitle">
          Don't memorize static diagrams. Learn how to derive scalable, resilient, and cost-effective architectures from first principles—spanning <strong>HLD</strong>, <strong>LLD</strong>, <strong>distributed consensus</strong>, <strong>machine coding</strong>, and <strong>2026 AI-native agentic systems</strong>.
        </p>

        <div class="hero-cta-row">
          <a href="#curriculum-tracks" class="btn btn-primary">
            Explore 19 Curriculum Tracks &darr;
          </a>
          <a href="/learn/playground" class="btn btn-secondary">
            Interactive Playground 🔬
          </a>
          <a href="#learning-paths" class="btn btn-secondary">
            Guided Career Paths &rarr;
          </a>
        </div>

        <!-- Search Bar Component -->
        <div class="search-section">
          <LearnSearch items={searchItems} />
        </div>
      </div>
    </section>

    <!-- Guided Learning Paths -->
    <section id="learning-paths" class="section learning-paths-section">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="badge badge-purple">STRUCTURED ROADMAPS</span>
            <h2 class="section-title">Role-Based Guided Learning Paths</h2>
          </div>
        </div>

        <p class="section-lead">
          Tailored progression roadmaps designed to take you from foundational computer mechanics to Staff/Principal-level architecture defense.
        </p>

        <div class="paths-grid">
          {LEARNING_PATHS.map((path) => (
            <LearningPathCard path={path} />
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Interactive Sandbox Callout -->
    <section class="section playground-banner-section">
      <div class="container">
        <div class="playground-banner">
          <div class="banner-content">
            <span class="badge badge-amber">HANDS-ON SIMULATORS</span>
            <h2 class="banner-title">The Interactive Architecture Sandbox</h2>
            <p class="banner-desc">
              Test failure scenarios in your browser: inject network latency, trigger cache stampedes, rebalance consistent hash rings, and simulate consumer backpressure.
            </p>
            <div class="banner-pills">
              <span class="pill-item">⚡ HTTP Timeout Simulator</span>
              <span class="pill-item">💾 Cache Eviction Engine</span>
              <span class="pill-item">🌐 Consistent Hashing Ring</span>
              <span class="pill-item">🛑 Rate Limiter Playground</span>
              <span class="pill-item">📬 Queue Backpressure</span>
              <span class="pill-item">📐 Capacity Calculator</span>
            </div>
            <a href="/learn/playground" class="btn btn-primary">
              Launch All 8 Simulators &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- All Curriculum Tracks -->
    <section id="curriculum-tracks" class="section tracks-section">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="badge badge-cyan">FULL CURRICULUM</span>
            <h2 class="section-title">Explore All 19 Architecture Tracks</h2>
          </div>
        </div>

        <p class="section-lead">
          Organized by foundational layers, persistence models, high-scale resilience, object-oriented design, and advanced distributed consensus.
        </p>

        <div class="tracks-grid">
          {LEARN_TRACKS.map((track) => (
            <TrackCard track={track} lessonCount={lessonCountByTrack[track.id] || 0} />
          ))}
        </div>
      </div>
    </section>

    <!-- Core / Starter Lessons -->
    {featuredLessons.length > 0 && (
      <section class="section featured-lessons-section">
        <div class="container">
          <div class="section-header">
            <div>
              <span class="badge badge-emerald">CANONICAL LESSONS</span>
              <h2 class="section-title">Core Deep Dives</h2>
            </div>
          </div>

          <div class="lessons-grid">
            {featuredLessons.map((l) => {
              const cleanSlug = l.slug.split('/').pop()?.replace(/^\d+-/, '') || l.slug;
              return (
                <article class="card card-interactive lesson-preview-card">
                  <div class="preview-header">
                    <span class="badge badge-subtle">{l.data.track.toUpperCase()}</span>
                    <span class="badge badge-cyan">{l.data.level.toUpperCase()}</span>
                  </div>
                  <h3 class="preview-title">
                    <a href={`/learn/${l.data.track}/${cleanSlug}`}>{l.data.title}</a>
                  </h3>
                  {l.data.description && <p class="preview-desc">{l.data.description}</p>}
                  <div class="preview-footer">
                    {l.data.duration && <span class="preview-time">⏱️ {l.data.duration} mins</span>}
                    <a href={`/learn/${l.data.track}/${cleanSlug}`} class="preview-link">
                      Start Lesson &rarr;
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .learn-hub-page {
    padding-bottom: 5rem;
  }

  .learn-hero {
    padding: 3.5rem 0 2rem;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.08) 0%, transparent 60%);
  }

  .hero-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .learn-hero-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .learn-hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 820px;
    margin-bottom: 2rem;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .search-section {
    max-width: 720px;
  }

  .section {
    padding: 4rem 0;
  }

  .section-header {
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    margin: 0.5rem 0 0.5rem;
  }

  .section-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 720px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .paths-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .paths-grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  .playground-banner-section {
    padding: 2rem 0;
  }

  .playground-banner {
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-elevated) 100%);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .banner-title {
    font-size: 1.75rem;
    margin: 0.75rem 0 0.75rem;
    color: var(--text-primary);
  }

  .banner-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .banner-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .pill-item {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--accent-amber);
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .tracks-grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  .lessons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .lessons-grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  .lesson-preview-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .preview-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.6rem 0;
  }

  .preview-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .preview-title a:hover {
    color: var(--accent-primary);
  }

  .preview-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .preview-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
  }

  .preview-time {
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .preview-link {
    color: var(--accent-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .preview-link:hover {
    text-decoration: underline;
  }
</style>
